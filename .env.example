# Variáveis de Ambiente de Produção (NUNCA comitar o arquivo .env real no Git)
# Configure estas variáveis no painel da Vercel / Netlify / Servidor:

# Domínio oficial autorizado a enviar requisições para /api/contact (Proteção CSRF)
ALLOWED_ORIGIN=https://seudominio.com.br

# Chave Secreta do Cloudflare Turnstile (Validação anti-bot no back-end)
TURNSTILE_SECRET_KEY=

# Webhook privado (ex: Discord/Slack/Make/Resend) para receber os contatos sem expor no front-end
CONTACT_WEBHOOK_URL=
